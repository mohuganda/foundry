package oidc

import (
	"context"
	"crypto/tls"
	"crypto/x509"
	"encoding/json"
	coreoidc "github.com/coreos/go-oidc/v3/oidc"
	"io"
	"net/http"
	"net/url"
	"os"
	"regexp"
	"strings"
	"testing"
	"time"
)

// Run with the supplied auth/dev fixture; never point this test at a production realm.
func TestKeycloakIntegration(t *testing.T) {
	certFile := os.Getenv("FOUNDRY_KEYCLOAK_TEST_CA")
	if certFile == "" {
		t.Skip("start auth/dev/start.sh and set FOUNDRY_KEYCLOAK_TEST_CA")
	}
	pem, e := os.ReadFile(certFile)
	if e != nil {
		t.Fatal(e)
	}
	roots := x509.NewCertPool()
	if !roots.AppendCertsFromPEM(pem) {
		t.Fatal("invalid test CA")
	}
	client := &http.Client{Timeout: 10 * time.Second, Transport: &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}}}
	issuer := "https://localhost:8443/realms/foundry"
	response, e := client.Post(issuer+"/protocol/openid-connect/token", "application/x-www-form-urlencoded", strings.NewReader(url.Values{"grant_type": {"client_credentials"}, "client_id": {"foundry-test"}, "client_secret": {"local-test-only"}}.Encode()))
	if e != nil {
		t.Fatal(e)
	}
	defer response.Body.Close()
	if response.StatusCode != 200 {
		t.Fatalf("token endpoint status %d", response.StatusCode)
	}
	var token struct {
		AccessToken string `json:"access_token"`
	}
	if e = json.NewDecoder(response.Body).Decode(&token); e != nil {
		t.Fatal(e)
	}
	ctx := coreoidc.ClientContext(context.Background(), client)
	v, e := New(ctx, issuer, "programme-api", "keycloak")
	if e != nil {
		t.Fatal(e)
	}
	id, e := v.Verify(ctx, token.AccessToken)
	if e != nil || id.Issuer != issuer || id.UserID == "" {
		t.Fatalf("Keycloak access token rejected: %v", e)
	}
	wrong, e := New(ctx, issuer, "unrelated-api", "keycloak")
	if e != nil {
		t.Fatal(e)
	}
	if _, e = wrong.Verify(ctx, token.AccessToken); e == nil {
		t.Fatal("accepted wrong audience")
	}
	// The inherited credential form must render with the shared theme, not a broken override.
	authorize := issuer + "/protocol/openid-connect/auth?" + url.Values{"client_id": {"programme-web"}, "redirect_uri": {"https://localhost:5173/auth/callback"}, "response_type": {"code"}, "scope": {"openid"}, "state": {"theme-check"}, "nonce": {"theme-check"}, "code_challenge_method": {"S256"}, "code_challenge": {"012345678901234567890123456789012345678901234"}}.Encode()
	page, e := client.Get(authorize)
	if e != nil {
		t.Fatal(e)
	}
	defer page.Body.Close()
	body, e := io.ReadAll(page.Body)
	if e != nil {
		t.Fatal(e)
	}
	if page.StatusCode != 200 || !strings.Contains(string(body), "foundry.css") || !strings.Contains(string(body), "foundry-organisation") || !strings.Contains(string(body), "login-actions/authenticate") {
		t.Fatalf("themed Keycloak credential page did not render (status %d)", page.StatusCode)
	}

	resources := regexp.MustCompile(`href="([^"]*foundry(?:-tokens)?\.css)"`).FindAllStringSubmatch(string(body), -1)
	if len(resources) != 2 {
		t.Fatal("shared theme stylesheets are missing")
	}
	for _, resource := range resources {
		target, e := url.Parse(resource[1])
		if e != nil {
			t.Fatal(e)
		}
		base, _ := url.Parse(issuer)
		target = base.ResolveReference(target)
		asset, e := client.Get(target.String())
		if e != nil {
			t.Fatal(e)
		}
		data, e := io.ReadAll(asset.Body)
		asset.Body.Close()
		if e != nil {
			t.Fatal(e)
		}
		if asset.StatusCode != 200 || len(data) == 0 {
			t.Fatalf("theme resource failed: %d", asset.StatusCode)
		}
		if strings.Contains(resource[1], "foundry-tokens.css") && !strings.Contains(string(data), "--login-max-width: 440px") {
			t.Fatal("provider theme design contract missing")
		}
	}

}
